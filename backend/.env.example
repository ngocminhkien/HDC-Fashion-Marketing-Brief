# ========================================================
# HDC Fashion — Backend Environment Configuration Template
# Copy this file to .env and replace with your secrets
# ========================================================

# Application Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=HDC_Fashion_API
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://hdcfashion.vn

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://hdc_user:hdc_secure_password@localhost:5432/hdc_fashion_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=hdc_user
DB_PASSWORD=hdc_secure_password
DB_NAME=hdc_fashion_db
DB_SSL=false

# Redis Cache & Session Store
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=hdc_fashion_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment Gateways (Vietnam)
# VNPay Sandbox credentials
VNPAY_TMN_CODE=HDCFASHION
VNPAY_HASH_SECRET=SECRETKEYVNPAY
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/#/checkout/callback

# MoMo Sandbox credentials
MOMO_PARTNER_CODE=MOMO_TEST
MOMO_ACCESS_KEY=MOMO_ACCESS
MOMO_SECRET_KEY=MOMO_SECRET
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# Transactional Email (Brevo / SendGrid / SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=contact@hdcfashion.vn
SMTP_PASS=your_smtp_password
EMAIL_FROM="HDC Fashion <no-reply@hdcfashion.vn>"
B2B_NOTIFICATION_EMAIL=sales@hdcfashion.vn
